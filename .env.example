# ================================
# SERVER CONFIGURATION
# ================================
PORT=8080
NODE_ENV=production
APP_URL=https://your-app-domain.railway.app/api/v1

# ================================
# DATABASE CONFIGURATION (SUPABASE)
# ================================
# Direct connection (for pg_dump, migrations, Prisma)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Transaction/Pooler connection (for Edge Functions, high-concurrency)
# DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@pooler.supabase.com:6543/postgres

# ================================
# SUPABASE (custom variables)
# ================================
# NOTE: SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY
# are auto-injected by Supabase in Edge Functions. Don't set them manually.
PROJECT_REF=YOUR-PROJECT-REF

# ================================
# JWT AUTHENTICATION
# ================================
# secure secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-for-a-super-secrete-64-characteres

# Salts number for bcrypt (10 is recommendated for production)
SALT_ROUNDS=10

# Expiration time of access token in minutes (30 minutes = 0.5 hours)
JWT_ACCESS_EXPIRATION_MINUTES=30

# Expiration days of refresh token in days (7 days = 1 week)
JWT_ACCESS_EXPIRATION_DAYS=7

# ================================
# CORS 
# ================================
 ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-frontend.app

# ================================
# EMAIL CONFIGURATION (RESEND)
# ================================
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=no-reply@plaet.cloud

# ================================
# STORAGE (SUPABASE — replaces Cloudinary)
# ================================
STORAGE_BUCKET=plaet-media
